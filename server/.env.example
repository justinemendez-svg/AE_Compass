# Database (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=salespilot
DB_USER=salespilot
DB_PASS=your_password_here

# Admin password for CSV upload
ADMIN_PASSWORD=change_me

# Server port (Cloud Run sets this automatically)
PORT=8080

# Flask debug mode (set to 1 for local dev)
FLASK_DEBUG=0
OPENAI_BASE_URL=
OPENAI_API_KEY=
OPENAI_ASSISTANT_MODEL=gpt-5.5
OPENAI_TIMEOUT_SECONDS=45
