# Copy these into the AppFoundry runtime configuration; do not commit secrets.
AE_COMPASS_DATA_DIR=/app/runtime-data
AE_COMPASS_STATE_DIR=/app/runtime-state
AE_COMPASS_LOCAL_EMAIL=your.name@zendesk.com
AE_COMPASS_ADMIN_PASSWORD=configure-in-appfoundry-secret

# Ask Compass: use the approved internal gateway secret in AppFoundry's secret store.
OPENAI_BASE_URL=https://ai-gateway.zende.sk/v1
OPENAI_API_KEY=replace-with-appfoundry-secret
OPENAI_ASSISTANT_MODEL=gpt-5.5

# Optional only when the deployment has a read-only GTM/Snowflake bridge.
AE_COMPASS_GTM_REPO=/app/gtm-ops-claude
AE_COMPASS_GTM_PYTHON=/usr/local/bin/python
